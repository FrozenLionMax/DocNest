# DocNest Environment Variables
# Copy this to .env and fill in your values

# Supabase (get from supabase.com → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay (get from razorpay.com → Dashboard → Settings → API Keys)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Medicave WhatsApp (your Medicave business WhatsApp number)
EXPO_PUBLIC_MEDICAVE_WHATSAPP=919XXXXXXXXX
EXPO_PUBLIC_MEDICAVE_PHONE=9XXXXXXXXX
